FROM ubuntu@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
LABEL org.opencontainers.image.title="Homelab isolated Ollama CPU component fixture" \
      org.opencontainers.image.version="0.40.6-test-only" \
      org.opencontainers.image.source="https://github.com/ollama/ollama/releases/tag/v0.40.6"
COPY --chmod=755 cpu/bin/ollama /usr/bin/ollama
COPY cpu/lib/ollama /usr/lib/ollama
COPY ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN chmod 755 /usr/lib/ollama/llama-server /usr/lib/ollama/llama-quantize
ENV OLLAMA_HOST=0.0.0.0:11434 OLLAMA_MODELS=/models OLLAMA_CONTEXT_LENGTH=2048 OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_KEEP_ALIVE=30s HOME=/tmp
USER 10001:10001
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]
