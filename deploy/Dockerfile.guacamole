FROM maven:3.9.9-eclipse-temurin-17@sha256:f58d59b6273e785ac0a4477f6e9b5ba1d7731c75b906c0f7b34076f1851318cc AS listener-build
WORKDIR /source
COPY docs/remote/gateway-extension/pom.xml ./pom.xml
COPY docs/remote/gateway-extension/src ./src
RUN mvn --batch-mode --no-transfer-progress -Dproject.build.outputTimestamp=2026-10-20T00:00:00Z package

FROM guacamole/guacamole:1.6.0@sha256:f344085e618bb05e22b964b0208dbd06d3468275bac70206f93805245e067b40
COPY --from=listener-build /source/target/homelab-session-lease-1.0.0.jar /ops/guacamole-home/extensions/homelab-session-lease-1.0.0.jar
COPY deploy/guacamole-entrypoint.sh /ops/guacamole-entrypoint.sh
