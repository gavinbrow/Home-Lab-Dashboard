NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://homelab:replace-with-local-password@localhost:5432/homelab
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
ARTIFACT_ROOT=./data/artifacts
# Generate 32 random bytes as base64 and store outside database/backups.
MASTER_KEY=
# Initial owner creation only, at least 32 random characters; remove after bootstrap.
BOOTSTRAP_TOKEN=
DISPATCH_ENABLED=false
RESTORE_MODE=false
# Docker Compose only: absolute paths outside this checkout. Generate secrets using deploy/configure.py.
DATA_DIR=/srv/homelab-control/data
CONFIG_DIR=/srv/homelab-control/config
DASHBOARD_HOST=dashboard.localhost
# Change only to the exact private LAN/VPN interface after configuring firewall access.
BIND_ADDRESS=127.0.0.1
# Optional agent listener and desktop deployment overlays read protected key files.
AGENT_BIND_ADDRESS=127.0.0.1
# Server-only backup destination allowlist; never expose repository credentials or paths to browser config.
BACKUP_DESTINATIONS_FILE=
# Compose backup-worker image includes these pinned tools; bare processes must provision them explicitly.
PG_DUMP_BINARY=pg_dump
BACKUP_PYTHON_BINARY=python3
RESTIC_BINARY=restic
BACKUP_REPOSITORY_DIR=/srv/homelab-backups
# Separate protected migration secret, never passed to API/worker.
MIGRATION_DATABASE_URL=
